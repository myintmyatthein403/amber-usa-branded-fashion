# Database
DATABASE_URL="postgresql://user:password@localhost:5432/amber_db?schema=public"

# JWT
JWT_SECRET="your_jwt_secret_here"

# Used to build the password-reset link sent to users
FRONTEND_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# SMTP (transactional email — password reset, etc.). Any SMTP relay works:
# SES, SendGrid, Resend, Mailgun, or a Gmail app password for early beta.
# Emails are logged instead of sent if these are left unset (dev-only fallback).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="no-reply@yourdomain.com"

# Sentry (error tracking) — leave unset to no-op (safe in dev)
SENTRY_DSN=""

# CORS — comma-separated list of additional allowed origins beyond the
# built-in localhost/vercel.app defaults (see main.ts)
CORS_ALLOWED_ORIGINS=""

# Feedback submissions can optionally also be emailed to this address
FEEDBACK_NOTIFY_EMAIL=""
