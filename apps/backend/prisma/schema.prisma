generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  username        String?  @unique
  name            String?
  password        String?
  roleName        String?
  role            Role?    @relation(fields: [roleName], references: [name])
  provider        String?  // 'google', 'github', etc.
  providerId      String?  @unique // sub ID from provider
  phone           String?
  address         String?  @db.Text
  avatar          String?
  points          Int      @default(0)
  memberLevel     String   @default("Silver")
  status          UserStatus @default(ACTIVE)
  joinedAt        DateTime @default(now())
  
  orders          Order[]
  refundRequests  RefundRequest[]
  returnRequests  ReturnRequest[]
  addresses       SavedAddress[]
  wishlist        WishlistItem[]
  passwordResetTokens PasswordResetToken[]
  stockMovements  StockMovement[]
  reviews         Review[]
  questions       Question[]
  couponRedemptions CouponRedemption[]
  feedback        Feedback[]
}

enum FeedbackStatus {
  NEW
  REVIEWED
  RESOLVED
}

// Beta-readiness: the app previously had no mechanism at all for a user to
// report a bug or leave feedback — this is the whole point of running a
// beta, so it's the minimum viable version (a form + an admin inbox), not
// a polished/third-party feedback tool.
model Feedback {
  id        String         @id @default(uuid())
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  message   String         @db.Text
  page      String?
  userAgent String?
  status    FeedbackStatus @default(NEW)
  createdAt DateTime       @default(now())

  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?  @db.Text
  permissions String[]
  color       String?
  isImmutable Boolean  @default(false)
  
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
  REJECTED
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  date            DateTime    @default(now())
  status          OrderStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal     @db.Decimal(10, 2)
  currency        String      @default("USD")
  lockedExchangeRate Decimal? @db.Decimal(18, 6)
  market          String?     // "US" or "MM"
  shippingCountry String?
  paymentMethod   String
  shippingAddress String      @db.Text
  customerName    String?
  customerEmail   String?
  customerPhone   String?
  street          String?
  city            String?
  state           String?
  township        String?
  zipCode         String?
  deliveryMethodId String?
  deliveryFee     Decimal?    @db.Decimal(10, 2)
  paymentReference String?
  paymentProofUrl String?
  paymentProofUploadedAt DateTime?
  manualPaymentReviewedAt DateTime?
  manualPaymentReviewedBy String?
  manualPaymentRejectionReason String?
  stripePaymentIntentId String? @unique
  hasPreOrderItems Boolean     @default(false)
  restocked       Boolean     @default(false)
  depositAmount   Decimal?    @db.Decimal(10, 2) // Amount required upfront; null = full payment
  balanceDue      Decimal?    @db.Decimal(10, 2)
  balanceSettledAt DateTime?
  balanceSettledBy String?

  couponCode      String?
  discountAmount  Decimal?    @db.Decimal(10, 2)

  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  
  warehouseId     String?
  warehouse       Warehouse?  @relation("WarehouseOrders", fields: [warehouseId], references: [id], onDelete: SetNull)

  items           OrderItem[]
  refundRequest   RefundRequest?
  returnRequests  ReturnRequest[]
  couponRedemption CouponRedemption?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([warehouseId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id])

  name      String
  price     Decimal @db.Decimal(10, 2)
  currencyCode String @default("USD")
  unitPriceUsd Decimal? @db.Decimal(10, 2)
  isUsd     Boolean @default(true)
  quantity  Int
  image     String
  size      String?

  isPreOrder Boolean @default(false)
  expectedShippingDate DateTime?
  isDigital  Boolean @default(false)

  returnItems ReturnItem[]
  reviews     Review[]
  serialNumbers SerialNumber[]

  // NOTE: variantId is nullable, and Postgres treats NULLs as distinct in a
  // unique index — this does not fully prevent duplicate line items for a
  // simple (no-variant) product within the same order, only for variant
  // items. Left as a best-effort constraint rather than a full guarantee.
  @@unique([orderId, productId, variantId])
  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model RefundRequest {
  id        String       @id @default(uuid())
  orderId   String       @unique
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  
  reason    String
  comments  String?      @db.Text
  status    RefundStatus @default(PENDING)
  
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
}

enum ReturnItemCondition {
  RESELLABLE
  DAMAGED
}

model ReturnRequest {
  id        String       @id @default(uuid())
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?        @relation(fields: [userId], references: [id])

  reason    String
  comments  String?      @db.Text
  status    ReturnStatus @default(REQUESTED)

  items     ReturnItem[]

  processedAt DateTime?
  processedBy String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([status])
}

model ReturnItem {
  id              String               @id @default(uuid())
  returnRequestId String
  returnRequest   ReturnRequest        @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId     String
  orderItem       OrderItem            @relation(fields: [orderItemId], references: [id])

  quantity        Int
  // Set by the admin receiving flow when the physical item comes back —
  // RESELLABLE credits Inventory, DAMAGED logs a DAMAGE StockMovement
  // instead. Null until received.
  condition       ReturnItemCondition?
  receivedAt      DateTime?

  createdAt       DateTime             @default(now())

  @@index([returnRequestId])
  @@index([orderItemId])
}

model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String   @default("stripe")
  eventId     String   @unique
  eventType   String
  processedAt DateTime @default(now())

  @@index([provider])
}

enum ProductStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProductVisibility {
  USA
  MYANMAR
  BOTH
  PRE_ORDER_ONLY
}

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  status           ProductStatus @default(DRAFT)
  visibility       ProductVisibility @default(BOTH)
  publishAt        DateTime?
  shortDescription String?
  description      String?       @db.Text
  detail           String?       @db.Text
  note             String?       @db.Text
  
  // Pricing & Sale
  price            Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2) // Original price for "Sale" display
  cost             Decimal?      @db.Decimal(10, 2) // Cost of goods, for margin calculation
  currencyCode     String        @default("USD")
  isUsdPrice       Boolean       @default(true)      // Deprecated: derived from currencyCode === "USD"
  isFeatured       Boolean       @default(false)
  onSale           Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  stock            Int           @default(0)
  lowStockThreshold Int          @default(5)
  // Quantity at which an automated reorder alert should fire; distinct from
  // lowStockThreshold (display-only "low stock" badge). Null = not tracked.
  reorderPoint     Int?
  isDigital        Boolean       @default(false)

  // Pre-order Fields
  isPreOrder       Boolean       @default(false)
  preOrderShippingDate DateTime?
  preOrderNote     String?       @db.Text
  depositAmount    Decimal?      @db.Decimal(10, 2) // Upfront deposit for preorder items, informational only

  // Expiry
  expiryDate       DateTime?

  // SEO Fields
  metaTitle        String?
  metaDescription  String?

  // Denormalized review aggregate, recomputed transactionally whenever a
  // review is approved/rejected/deleted (see reviews.repository.ts) —
  // mirrors the recomputeAndSyncStock pattern already used for inventory.
  avgRating        Decimal       @default(0) @db.Decimal(3, 2)
  reviewCount      Int           @default(0)

  // Post-purchase policy overrides; null = fall back to the site-wide
  // default policy.
  warrantyMonths   Int?
  returnWindowDaysOverride Int?

  tags             String[]      @default([])
  images           String[]
  
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  
  variants         Variant[]
  collections      Collection[]  @relation("ProductCollections")

  saleId           String?
  sale             Sale?         @relation(fields: [saleId], references: [id])

  reviews          Review[]
  questions        Question[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]

  inventory        Inventory[]
  cargoItems       CargoItem[]
  stockMovements   StockMovement[]

  priceTiers       PriceTier[]
  prices           ProductPrice[]
  statusHistory    ProductStatusHistory[]
  scopedCoupons    Coupon[]
  mediaUsages      MediaUsage[]
  recommendationsFrom ProductRecommendation[] @relation("RecommendationSource")
  recommendationsTo   ProductRecommendation[] @relation("RecommendationTarget")

  @@index([categoryId])
  @@index([brandId])
  @@index([saleId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
}

model Review {
  id             String   @id @default(uuid())
  rating         Int      @default(5)
  comment        String?  @db.Text
  // Free-text fallback for admin-curated/social-sourced reviews that predate
  // (or intentionally bypass) real user accounts — kept alongside userId
  // rather than replaced, so that existing curation workflow keeps working.
  userName       String
  userProfileUrl String?  // Link to social profile
  platform       Platform @default(WEBSITE)
  isApproved     Boolean  @default(false)

  // Real customer submissions set these. A review is "verified" purely by
  // whether orderItemId resolves to a COMPLETED order belonging to userId
  // at write time — computed once and stored rather than re-derived on
  // every read (see ReviewsService.createCustomerReview).
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  orderItemId    String?
  orderItem      OrderItem? @relation(fields: [orderItemId], references: [id])
  isVerifiedPurchase Boolean @default(false)

  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // The hot path: every product-page view runs `{ productId, isApproved:
  // true }` ordered by createdAt (findApprovedByProduct) — this composite
  // index covers it directly instead of relying on the plain productId
  // index plus a post-filter/sort.
  @@index([productId, isApproved, createdAt])
  @@index([productId])
  @@index([userId])
  @@index([orderItemId])
}

enum Platform {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

model Sale {
  id            String    @id @default(uuid())
  name          String    @unique
  slug          String    @unique
  description   String?   @db.Text
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean   @default(true)
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal?     @db.Decimal(10, 2)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Collection {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  image       String?
  isActive    Boolean   @default(true)
  products    Product[] @relation("ProductCollections")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Coupon {
  id              String      @id @default(uuid())
  code            String      @unique
  description     String?
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Decimal     @db.Decimal(10, 2)
  minOrderAmount  Decimal?    @db.Decimal(10, 2)
  maxDiscount     Decimal?    @db.Decimal(10, 2)
  expiryDate      DateTime?
  usageLimit      Int?
  usageCount      Int         @default(0)
  isActive        Boolean     @default(true)

  // Scope: ORDER (default, cart-total) | PRODUCT | CATEGORY. Only the
  // matching field for the scope should be set — enforced at the app layer
  // (see CouponsService.validateCoupon), mirroring the variant/product XOR
  // convention already used on Inventory/StockMovement.
  scopeType       CouponScopeType @default(ORDER)
  scopeProductId  String?
  scopeProduct    Product?    @relation(fields: [scopeProductId], references: [id])
  scopeCategoryId String?
  scopeCategory   Category?   @relation(fields: [scopeCategoryId], references: [id])

  // BUY_X_GET_Y only: buy `buyQuantity` of the scoped product, get
  // `getQuantity` at the discount described by discountType/discountValue
  // (100% = free).
  buyQuantity     Int?
  getQuantity     Int?

  redemptions     CouponRedemption[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([scopeProductId])
  @@index([scopeCategoryId])
}

enum CouponScopeType {
  ORDER
  PRODUCT
  CATEGORY
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
  FREE_SHIPPING
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

model GiftCard {
  id             String    @id @default(uuid())
  code           String    @unique
  initialBalance Decimal   @db.Decimal(10, 2)
  currentBalance Decimal   @db.Decimal(10, 2)
  expiryDate     DateTime?
  isActive       Boolean   @default(true)
  note           String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(uuid())
  name      String    @unique
  logo      String?
  note      String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model HeroSection {
  id              String   @id @default(uuid())
  badge           String?
  titlePartOne    String
  titlePartTwo    String?
  titleItalic     Boolean  @default(true)
  description     String   @db.Text
  
  ctaPrimaryText  String   @default("Shop Brands")
  ctaPrimaryLink  String   @default("/shop")
  ctaSecondaryText String  @default("Check Legitimacy")
  ctaSecondaryLink String  @default("/track")
  
  imageMain       String?
  imageSecondary  String?
  
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MissionSection {
  id                    String   @id @default(uuid())
  badge                 String?  @default("Our Mission")
  title                 String
  titleItalic           String?
  description           String   @db.Text
  descriptionSecondary  String?  @db.Text
  
  featureOneTitle       String?
  featureOneDescription String?
  featureTwoTitle       String?
  featureTwoDescription String?
  
  trustBadgeText        String?
  
  imageMain             String
  imageSecondary        String?
  
  ctaText               String?  @default("Shop All Authentic Brands")
  ctaLink               String?  @default("/shop")
  
  isActive              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model GiftCardSection {
  id              String   @id @default(uuid())
  badge           String?  @default("The Ultimate Gift")
  title           String
  titleSecondary  String?
  description     String   @db.Text

  ctaText         String?  @default("Purchase a Gift Card")
  ctaLink         String?  @default("/gift-cards")

  cardTitle       String   @default("Amber")
  cardAmount      String   @default("100,000 MMK")
  cardType        String   @default("Gift Card")

  amounts         String[] @default(["50,000 MMK", "100,000 MMK", "200,000 MMK", "500,000 MMK"])

  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
model SaleSection {
  id              String   @id @default(uuid())
  badge           String?  @default("Limited Time Event")
  title           String
  titleItalic     String?
  description     String   @db.Text
  
  endDate         DateTime
  
  ctaText         String?  @default("Shop the Sale")
  ctaLink         String?  @default("/shop")
  
  imageMain       String?
  imageUrl        String?
  
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FooterSection {
  id                String   @id @default(uuid())
  companyName       String   @default("Amber")
  companySubtitle   String   @default("Premium USA Brands")
  companyDescription String  @db.Text
  
  instagramUrl      String?
  facebookUrl       String?
  
  contactAddress    String?
  contactPhone      String?
  contactEmail      String?
  
  copyrightText     String?
  
  isActive          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  text        String   @db.Text
  author      String
  location    String?
  role        String?
  rating      Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CommunityPost {
  id        String   @id @default(uuid())
  user      String
  handle    String
  comment   String   @db.Text
  image     String
  stars     Int      @default(5)
  likes     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id              String      @id @default(uuid())
  name            String      @unique
  slug            String      @unique
  description     String?     @db.Text
  image           String?
  isActive        Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  hasExpiry       Boolean     @default(false)
  displayOrder    Int         @default(0)

  metaTitle       String?
  metaDescription String?

  // Post-purchase policy override; null = fall back to the site-wide
  // default policy (same convention as Product.returnWindowDaysOverride,
  // which takes priority over this when both are set).
  returnWindowDaysOverride Int?

  parentId        String?
  parent          Category?   @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: Cascade)
  subcategories   Category[]  @relation("CategoryToSubcategory")

  products        Product[]
  scopedCoupons   Coupon[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([parentId])
}

model Variant {
  id                String   @id @default(uuid())
  sku               String   @unique
  barcode           String?  @unique // GTIN/UPC/EAN
  size              String
  color             String
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  // Quantity at which an automated reorder alert should fire; distinct from
  // lowStockThreshold (display-only "low stock" badge). Null = not tracked.
  reorderPoint      Int?

  buyPrice          Decimal? @db.Decimal(10, 2) // Purchase price in USA
  price             Decimal? @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  currencyCode      String   @default("USD")
  weight            Decimal? @default(0) @db.Decimal(10, 2)
  
  isPreOrder        Boolean  @default(false)
  preOrderShippingDate DateTime?
  attributeSelections Json?  // { "attrId1": "valueId1", "attrId2": "valueId2" }
  // When true, individual units of this variant are tracked via SerialNumber
  // (warranty/IMEI-style tracking) rather than just an aggregate quantity.
  tracksSerialNumbers Boolean @default(false)

  images            String[]

  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  inventory         Inventory[]
  cargoItems        CargoItem[]
  stockMovements    StockMovement[]
  priceTiers        PriceTier[]
  prices            ProductPrice[]
  serialNumbers     SerialNumber[]
  mediaUsages       MediaUsage[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orderItems        OrderItem[]

  @@index([productId])
}

model PaymentMethod {
  id            String   @id @default(uuid())
  name          String   @unique // e.g., "KBZPay", "WavePay"
  type          String   // "MANUAL" or "STRIPE"
  markets       String[] @default([]) // "US", "MM"
  accountName   String?
  accountNumber String?
  qrCode        String?
  instructions  String?  @db.Text
  isActive      Boolean  @default(true)
  isCod         Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id              String   @id @default("global")
  privacyPolicy   String?  @db.Text
  termsConditions String?  @db.Text

  // Stripe configuration
  stripePublishableKey String?
  stripeSecretKey      String?
  stripeWebhookSecret  String?

  // COD deposit configuration (flat MMK amount required upfront for Cash on Delivery orders)
  codDepositAmount Decimal? @db.Decimal(10, 2)
  // Deposit only required for customers with fewer than this many past paid orders; null = disabled
  codDepositOrderThreshold Int?

  updatedAt       DateTime @updatedAt
}

model DeliveryMethod {
  id             String   @id @default(uuid())
  name           String
  description    String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  isUsdPrice     Boolean  @default(false)
  isDigital      Boolean  @default(false)
  estimatedDays  String?
  isActive       Boolean  @default(true)
  freeOverAmount Decimal? @db.Decimal(10, 2)
  logoUrl        String?
  logoLink       String?
  locationPrices Json?    // { "USA": 10, "MYANMAR": 5000 }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Ad {
  id          String      @id @default(uuid())
  title       String
  description String?     @db.Text
  imageUrl    String
  linkUrl     String?
  placement   AdPlacement @default(HOME_HERO)
  status      AdStatus    @default(DRAFT)
  startDate   DateTime?
  endDate     DateTime?
  priority    Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum AdPlacement {
  TOP_BAR
  HOME_HERO
  HOME_BANNER
  PRODUCT_PAGE
  POPUP
}

enum AdStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CargoStatus {
  PREPARING
  DEPARTED
  IN_TRANSIT
  ARRIVED_MYANMAR
  CUSTOMS_CLEARANCE
  READY_FOR_DISTRIBUTION
  COMPLETED
}

model Warehouse {
  id          String      @id @default(uuid())
  name        String      @unique
  location    String      // "USA" or "MYANMAR"
  address     String?     @db.Text
  
  inventory   Inventory[]
  originShipments      CargoShipment[] @relation("OriginWarehouse")
  destinationShipments CargoShipment[] @relation("DestinationWarehouse")
  orders               Order[]         @relation("WarehouseOrders")
  stockMovementsFrom   StockMovement[] @relation("StockMovementFromWarehouse")
  stockMovementsTo     StockMovement[] @relation("StockMovementToWarehouse")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id          String    @id @default(uuid())
  variantId   String?
  variant     Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int       @default(0)
  // Bin/shelf/aisle within the warehouse, free text (e.g. "A-12-3"). Null =
  // not tracked yet.
  location    String?

  @@unique([variantId, warehouseId])
  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model CargoShipment {
  id              String        @id @default(uuid())
  shipmentNumber  String        @unique
  status          CargoStatus   @default(PREPARING)
  carrier         String?
  trackingNumber  String?
  
  originId        String
  origin          Warehouse     @relation("OriginWarehouse", fields: [originId], references: [id])
  destinationId   String
  destination     Warehouse     @relation("DestinationWarehouse", fields: [destinationId], references: [id])
  
  departureDate   DateTime?
  arrivalDate     DateTime?
  eta             DateTime?
  customsFee      Decimal?      @db.Decimal(10, 2)
  freightCost     Decimal?      @db.Decimal(10, 2)
  landedCost      Decimal?      @db.Decimal(10, 2)
  documents       Json?         // S3 URL refs
  
  items           CargoItem[]
  notes           String?       @db.Text

  // Track inventory state (Finding 2)
  originDeducted     Boolean   @default(false)
  destinationAdded   Boolean   @default(false)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model CargoItem {
  id          String        @id @default(uuid())
  shipmentId  String
  shipment    CargoShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant?      @relation(fields: [variantId], references: [id])
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id])
  quantity    Int

  @@index([shipmentId])
  @@index([variantId])
  @@index([productId])
}

model Media {
  id        String   @id @default(uuid())
  url       String
  publicId  String   @unique
  fileName  String
  format    String
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usages    MediaUsage[]
}

// Tracks which Product/Variant currently reference a Media asset's URL, so
// deleting a Media row can check for live references first. Product.images/
// Variant.images remain plain string arrays (too many other call sites
// already assume that shape to change it) — this is an additive tracking
// table populated whenever MediaSelector's onSelect is used, not a
// replacement for those columns.
model MediaUsage {
  id        String   @id @default(uuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([mediaId])
  @@index([productId])
  @@index([variantId])
}

enum StockMovementReason {
  TRANSFER
  ADJUSTMENT
  RECEIVING
  DAMAGE
  SALE
  RESTOCK
}

model StockMovement {
  id              String              @id @default(uuid())
  variantId       String?
  variant         Variant?            @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromWarehouseId String?
  fromWarehouse   Warehouse?          @relation("StockMovementFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId   String?
  toWarehouse     Warehouse?          @relation("StockMovementToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  quantity        Int
  reason          StockMovementReason
  note            String?
  userId          String?
  user            User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([variantId])
  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
}

model SavedAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  country    String   // "US" or "MM"
  street     String
  city       String
  state      String?
  township   String?
  zipCode    String?
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  createdAt DateTime @default(now())

  @@unique([userId, productId, variantId])
  @@index([productId])
}

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  symbol        String
  isBase        Boolean  @default(false)
  isActive      Boolean  @default(true)
  decimalPlaces Int      @default(2)
  position      String   @default("prefix")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fromRates     ExchangeRate[] @relation("FromCurrency")
  toRates       ExchangeRate[] @relation("ToCurrency")
}

model ExchangeRate {
  id               String   @id @default(uuid())
  fromCurrencyId   String
  toCurrencyId     String
  rate             Decimal  @db.Decimal(18, 6)
  effectiveDate    DateTime @default(now())
  lastFetchedAt    DateTime?
  isManualOverride Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fromCurrency     Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency       Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])

  @@unique([fromCurrencyId, toCurrencyId])
}

model Attribute {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  type         String   @default("text")
  isRequired   Boolean  @default(false)
  isFilterable Boolean  @default(false)
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  values       AttributeValue[]
}

model AttributeValue {
  id          String   @id @default(uuid())
  attributeId String
  value       String
  slug        String
  position    Int      @default(0)
  hexColor    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, slug])
}

// --- Product Q&A ---
// Mirrors Review's moderation shape deliberately: isApproved gates public
// display, userName is a fallback for unauthenticated/legacy entries.
model Question {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  userName   String?
  body       String   @db.Text
  isApproved Boolean  @default(false)

  answers    Answer[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Same hot-path reasoning as Review.@@index([productId, isApproved, createdAt]).
  @@index([productId, isApproved, createdAt])
  @@index([productId])
  @@index([userId])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  // Set when an admin/staff member answers, so the frontend can render an
  // "Official Store Answer" badge distinct from a peer answer.
  answeredBy String?
  isOfficial Boolean  @default(false)

  createdAt  DateTime @default(now())

  @@index([questionId])
}

// --- Wholesale / tiered pricing ---
// Exactly one of productId/variantId must be set (app-layer XOR, same
// convention as Inventory/StockMovement/CargoItem). minQuantity is the
// break point: the highest tier whose minQuantity <= the ordered quantity
// applies.
model PriceTier {
  id          String   @id @default(uuid())
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  minQuantity Int
  price       Decimal  @db.Decimal(10, 2)
  currencyCode String  @default("USD")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([variantId])
}

// --- True multi-currency product pricing ---
// An explicit, independently-curated price for a given currency, overriding
// the default FX-conversion-from-USD path in ExchangeRateHelper when a row
// exists for the order's currency.
model ProductPrice {
  id           String   @id @default(uuid())
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  currencyCode String
  price        Decimal  @db.Decimal(10, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, currencyCode])
  @@unique([variantId, currencyCode])
}

// --- Product status audit trail ---
model ProductStatusHistory {
  id         String        @id @default(uuid())
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromStatus ProductStatus?
  toStatus   ProductStatus
  changedBy  String?
  note       String?
  createdAt  DateTime      @default(now())

  @@index([productId])
}

// --- Serial number / warranty unit tracking ---
enum SerialStatus {
  AVAILABLE
  SOLD
  RETURNED
}

model SerialNumber {
  id           String       @id @default(uuid())
  variantId    String
  variant      Variant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  serialNumber String       @unique
  status       SerialStatus @default(AVAILABLE)
  orderItemId  String?
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([variantId])
  @@index([orderItemId])
}

// --- Recommendations ---
// Admin-curatable overrides layered on top of the algorithmic
// category+attribute scoring in ProductsService.getRelatedProducts — a row
// here always wins over the computed score for that (productId, type) pair.
enum RecommendationType {
  RELATED
  FREQUENTLY_BOUGHT_TOGETHER
}

model ProductRecommendation {
  id                  String             @id @default(uuid())
  productId           String
  product             Product            @relation("RecommendationSource", fields: [productId], references: [id], onDelete: Cascade)
  recommendedProductId String
  recommendedProduct  Product            @relation("RecommendationTarget", fields: [recommendedProductId], references: [id], onDelete: Cascade)
  type                RecommendationType
  position            Int                @default(0)

  createdAt           DateTime           @default(now())

  @@unique([productId, recommendedProductId, type])
  @@index([productId])
}
